    const-string v5, ";\n    const renderRoot = document.getElementById(\"render-root\");\n    const fallback = document.getElementById(\"fallback\");\n\n    function showFallback(error) {\n      renderRoot.replaceChildren();\n      fallback.style.display = \"block\";\n      console.error(\"Unable to render thread diff with @pierre/diffs\", error);\n    }\n\n    function fileTitle(fileDiff) {\n      if (\n        fileDiff.prevName &&\n        fileDiff.prevName !== fileDiff.name\n      ) {\n        return displayFileName(fileDiff.prevName) +\n          \" -> \" +\n          displayFileName(fileDiff.name);\n      }\n      return displayFileName(fileDiff.name);\n    }\n\n    function displayFileName(fileName) {\n      return fileName.replace(/-/g, String.fromCharCode(0x2011));\n    }\n\n    function fileChangeCounts(fileDiff) {\n      return fileDiff.hunks.reduce(\n        (totals, hunk) => ({\n          added: totals.added + hunk.additionLines,\n          removed: totals.removed + hunk.deletionLines\n        }),\n        { added: 0, removed: 0 }\n      );\n    }\n\n    function createFileCard(fileDiff, FileDiffComponent) {\n      const { fileCard, fileBody } = createFileCardShell(fileDiff);\n      addFileCardToggle(fileCard);\n      renderFileDiff(fileDiff, FileDiffComponent, fileBody);\n      return fileCard;\n    }\n\n    function createFileCardShell(fileDiff) {\n      const fileCard = document.createElement(\"div\");\n      fileCard.className = \"file-card\";\n\n      const fileBody = document.createElement(\"div\");\n      const fileControlRow = document.createElement(\"button\");\n      const fileToggle = document.createElement(\"span\");\n      const fileTitleWrapper = document.createElement(\"span\");\n      const fileName = document.createElement(\"span\");\n      const fileCounts = document.createElement(\"span\");\n      const addedCount = document.createElement(\"span\");\n      const removedCount = document.createElement(\"span\");\n      const counts = fileChangeCounts(fileDiff);\n\n      fileBody.className = \"file-body\";\n      fileControlRow.className = \"file-control-row\";\n      fileControlRow.type = \"button\";\n      fileControlRow.setAttribute(\"aria-expanded\", \"true\");\n      fileControlRow.setAttribute(\"aria-label\", \"Toggle \" + fileTitle(fileDiff));\n      fileToggle.className = \"file-toggle\";\n      fileToggle.innerHTML = \"<svg viewBox=\'0 0 16 16\' aria-hidden=\'true\'><path d=\'M4.5 6.25L8 9.75L11.5 6.25\' /></svg>\";\n      fileTitleWrapper.className = \"file-title-wrap\";\n      fileName.className = \"file-title\";\n      fileName.textContent = fileTitle(fileDiff);\n      fileCounts.className = \"file-counts\";\n      addedCount.className = \"added\";\n      addedCount.textContent = \"+\" + counts.added;\n      removedCount.className = \"removed\";\n      removedCount.textContent = \"-\" + counts.removed;\n\n      fileCounts.append(addedCount, removedCount);\n      fileTitleWrapper.append(fileName);\n      fileControlRow.append(fileToggle, fileTitleWrapper, fileCounts);\n      fileCard.append(fileControlRow, fileBody);\n      prepareScrollableTitle(fileTitleWrapper, fileName);\n\n      return { fileCard, fileBody };\n    }\n\n    const titleResizeObservers = [];\n\n    function prepareScrollableTitle(fileTitleWrapper, fileName) {\n      syncScrollableTitleTail(fileTitleWrapper, fileName);\n      if (typeof ResizeObserver !== \"undefined\") {\n        const titleResizeObserver = new ResizeObserver(() => syncScrollableTitleTail(fileTitleWrapper, fileName));\n        titleResizeObserver.observe(fileName);\n        titleResizeObservers.push(titleResizeObserver);\n      } else {\n        window.addEventListener(\"resize\", () => syncScrollableTitleTail(fileTitleWrapper, fileName));\n      }\n      fileName.addEventListener(\"scroll\", () => syncScrollableTitle(fileTitleWrapper, fileName), { passive: true });\n    }\n\n    function syncScrollableTitleTail(fileTitleWrapper, fileName) {\n      req