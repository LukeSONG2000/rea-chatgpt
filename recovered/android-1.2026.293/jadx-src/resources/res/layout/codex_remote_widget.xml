<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:background="@drawable/codex_remote_widget_background"
    android:padding="16dp"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:gravity="center_vertical"
        android:id="@+id/remote_widget_header"
        android:layout_width="match_parent"
        android:layout_height="48dp">
        <ImageView
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:src="@drawable/codex_app_icon"
            android:contentDescription="@null"/>
        <TextView
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="@color/primary"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="@string/_1505_res_0x7f13165a"
            android:layout_weight="1"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"/>
        <TextView
            android:textSize="14sp"
            android:textColor="@color/primary"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/_1507_res_0x7f13165c"/>
    </LinearLayout>
    <TextView
        android:textSize="12sp"
        android:textColor="@color/primary"
        android:id="@+id/remote_widget_message"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/_1508_res_0x7f13165d"
        android:alpha="0.7"/>
    <TextView
        android:textSize="12sp"
        android:textColor="@color/primary"
        android:id="@+id/remote_widget_timestamp"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:alpha="0.7"/>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/remote_widget_rows"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>
</LinearLayout>
