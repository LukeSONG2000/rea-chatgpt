<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android">
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="56dp">
        <ImageView
            android:layout_gravity="center"
            android:layout_width="wrap_content"
            android:layout_height="22dp"
            android:src="@drawable/plaid_ic_logo"
            android:adjustViewBounds="true"
            android:importantForAccessibility="no"/>
        <ImageButton
            android:layout_gravity="end|center_vertical"
            android:id="@+id/errorCloseButton"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:src="@drawable/plaid_ic_close"
            android:scaleType="center"
            android:contentDescription="@string/_12e6_res_0x7f13143a"
            android:layout_marginEnd="4dp"/>
    </FrameLayout>
    <LinearLayout
        android:gravity="center"
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:paddingStart="24dp"
        android:paddingEnd="24dp">
        <ImageView
            android:background="@drawable/plaid_error_icon_badge"
            android:padding="14dp"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:layout_marginBottom="16dp"
            android:src="@drawable/plaid_ic_error_warning"
            android:scaleType="fitCenter"
            android:importantForAccessibility="no"/>
        <TextView
            android:textSize="20sp"
            android:textColor="@color/plaid_error_title"
            android:gravity="center"
            android:id="@+id/errorTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:lineSpacingExtra="4sp"
            android:fontFamily="sans-serif-medium"
            android:letterSpacing="-0.01"/>
        <TextView
            android:textSize="14sp"
            android:textColor="@color/plaid_error_message"
            android:gravity="center"
            android:id="@+id/errorMessage"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:lineSpacingExtra="4sp"
            android:fontFamily="sans-serif"
            android:letterSpacing="0.016"/>
    </LinearLayout>
    <Button
        android:textSize="18sp"
        android:textColor="@color/plaid_error_button_text"
        android:id="@+id/errorExitButton"
        android:background="@drawable/plaid_error_button_background"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginBottom="16dp"
        android:text="@string/_12e7_res_0x7f13143b"
        android:textAllCaps="false"
        android:fontFamily="sans-serif-medium"
        android:layout_marginStart="24dp"
        android:layout_marginEnd="24dp"
        android:stateListAnimator="@null"/>
</merge>
