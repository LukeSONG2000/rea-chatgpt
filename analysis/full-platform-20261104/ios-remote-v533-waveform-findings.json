  "algorithm": {
    "valid_domain": "Finite Float samples, nonnegative finite geometry, positive pitch.",
    "incoming_samples": [
      "k = largest overlap length with old.suffix(k) == new.prefix(k)",
      "pending += new.dropFirst(k), or all new when no overlap"
    ],
    "tick": [
      "if flag84d40ec & 1: return",
      "offset += min(1/30, max(newDate-oldDate,0)) * velocity",
      "if offset > lineWidth+spacing:",
      "  sample = mean(pending) if nonempty else originalPredictor(displayed.suffix(5))",
      "  if sample != nil: displayed.append(sample)",
      "  pending = []",
      "  offset -= lineWidth+spacing"
    ],
    "draw": [
      "pitch = lineWidth + spacing",
      "for i in 0..<(floor(width/pitch)+1):",
      "  x = width - i*pitch - offset",
      "  sample = displayed[displayed.count-1-i] when in bounds",
      "  normalized = Double(Float(sample*16)) for present sample, otherwise0",
      "  h = max(minHeight, min((height-lineWidth)*normalized, height-lineWidth))",
      "  color = presentSampleColor for present sample, otherwise missingSampleColor",
      "  if h>0: stroke segment (x,(height-h)/2) to (x,(height+h)/2)",
      "  else: fill ellipse x-lineWidth/2, height/2-lineWidth/2, lineWidth,lineWidth"
    ]
  },
