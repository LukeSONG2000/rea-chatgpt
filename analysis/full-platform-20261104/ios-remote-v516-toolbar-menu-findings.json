  "artifact_sha256": "12c03ceded0ce669421b6a9a4e4799104a4a82e491a425652df1aa92a116a6c9",
  "findings": [
    {
      "kind": "official_artifact_static",
      "conclusion": "Thread toolbar Menu content is a Section. Its header reads VM witness+0x28, also consumed by the location title. The content constructs ActionButtonsContent with keyboardShortcutsEnabled true.",
      "offsets": [
        "0x1ce9428",
        "0x1ce94b0",
        "0x1ce94c4",
        "0x1ce90b4",
        "0x1d9f06c",
        "0x199d55c",
        "0x7e13f0"
      ],
      "binding": "0xaad5440 SwiftUI.Section.create(isExpanded:content:header:footer:)"
    },
    {
      "kind": "official_artifact_static",
      "conclusion": "After pin/rename/copy/archive, 0x1a1cbd8 calls an extra-content builder. Changes uses witness+0x58 and Files uses witness+0x60 independently. The subview adapter contains Divider and EmptyConditionalContent.",
      "offsets": [
        "0x1a1cd78",
        "0x1a1ce14",
        "0x1a1cf1c",
        "0x1a1d124"
      ],
      "type_record": "0x7e13310"
    },
    {
      "kind": "official_artifact_static",
      "conclusion": "Changes label uses codex_remote_thread_changes_action, default Changes, OpenAI/Symbols/branch. Files uses codex_remote_thread_files_action, default Files, OpenAI/Symbols/folder.",
      "offsets": [
        "0x88b3bf0",
        "0x88b3bc0",
        "0x74f54c4",
        "0x8a544c0",
        "0x74f7708",
        "0x8a554f0"
      ]
    },
    {
      "kind": "official_artifact_static",
      "conclusion": "Changes and Files dispatch distinct context action codes 0x3e and 0x3f through common 0x1a1d080 and VM witness+0x78. Neither callback directly constructs the message-inline diff component.",
      "offsets": [
        "0x1c2ba88",
        "0x1c2ba68",
        "0x1a1d0c8"
      ]
    },
    {
      "kind": "official_artifact_static",
      "conclusion": "Concrete VM witness table a504d18 maps Changes predicate to19433a0->18efdb0 and Files predicate to19433a4->18efd74. Both depend on a nonnil result from1902f08, with separate additional gates. The dynamic fields behind those gates remain unresolved.",
      "offsets": [
        "0xa504d18",
        "0x19433a0",
        "0x19433a4",
        "0x18efdb0",
        "0x18efd74",
        "0x1902f08"
      ]
    },
    {
      "kind": "official_artifact_static",
      "conclusion": "Standalone new-thread toolbar button uses square-and-pencil before Options and an explicit showsNewThreadButton gate. Callback1ce9408 dispatches+0x80 through19433b4->1901af0, which calls a parent-captured closure with optional context from1902f08.",
      "offsets": [
        "0x1a30484",
        "0x1a3052c",
        "0x1a30848",
        "0x2f6134",
        "0x1ce9408",
        "0x19433b4",
        "0x1901af0"
      ]
    }
  ],
  "integration": [
    "Recovered title height44 and sharedBackgroundVisibility hidden as separately proved in title-layout-findings.",
    "Menu receives title and two explicit capability inputs. The synthetic fixture-a/shared-thread has both true. Other sample tasks use false. These assignments are independent test data, not recovered host capability rules.",
    "Changes/Files retain request scope and show disconnected status. Original downstream inspector pages remain pending.",
    "The same synthetic task receives an explicit parent-owned new-draft target fixture-a /fixtures/ui. Existing scoped draft route is reused. Its parent context projection and navigation adapter are independent, not claimed equivalent to the original captured closure.",
    "Retain293 principal placement on26+. Newer screenshot left-position gap remains open pending outer navigation owner/version evidence."
  ],
  "unknowns": [
    "Exact provider/context-field derivation for menu visibility and Changes/Files predicates",
    "Original parent production of showsNewThreadButton and captured new-thread closure destination",
    "Original Changes/Files inspector views and remote data service",
    "Newer screenshot exact version and outer navigation owner causing left-position title"
  ],
