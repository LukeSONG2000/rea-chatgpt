    "version": "1.2026.293"
  },
  "official_artifact_observations": [
    {
      "id": "LISTLIFE-01",
      "classification": "official-artifact-observation",
      "conclusion": "The ordinary scroll carrier is SwiftUI List<Never,Content>, not ScrollView and not a List(selection:) binding. selectedThreadID is supplied separately to the content/row navigation path. No viewport anchor follows from selectedThreadID alone.",
      "source": [
        "CodexTaskListContainer descriptor0x95d0b08 conformance0x7e854a8 bodywitness0x2403b68→0x24034e0",
        "0x240390c SwiftUI.ListVAAs5NeverORszrlE7content...init(content:)",
        "0x2403918 PlainListStyle.init /0x2403948 listStyle",
        "0x24039dc listSectionSeparator /0x2403a18 listRowSpacing /0x2403a34 custom ListSectionSpacing(0) /0x2403a5c listSectionSpacing",
        "0x2403968..0x240399c usesSoftScrollEdges forwards to0x2403b58; v540 evidence retained"
      ],
      "limits": [
        "List row spacing call receives zero and optional tag0 at0x24039f8/39fc; generic ABI optional-tag interpretation is not elevated to a global host style rule.",
        "No implicit SwiftUI List viewport persistence guarantee established."
      ]
    },
    {
      "id": "LISTLIFE-02",
      "classification": "official-artifact-observation",
      "conclusion": "TaskList lifetime wraps CodexTaskListContent in two AppearanceActionModifiers and a CodexRemoteThreadRenamePresentation. The on-appear/disappear callbacks operate __hasAppeared and call a common VM Bool setter; these calls do not establish scroll restoration.",
      "source": [
        "CodexTaskList descriptor0x955fb94 conformance0x7cf5778 bodywitness0x397038→0x395b50",
        "actual parent records0x7cf65a0/0x7cf65a8/0x7cf65b0/0x7cf65b8; unresolved anonymous context retained as original descriptor0x9560294=CodexTaskListContent",
        "0x395c94..0x395ca4 callback0x42dc84 /0x395cd0..0x395cd8 callback0x42dd70",
        "0x42dcb8 LazyState wrappedValue;0x42dcc0 guards existingtrue;0x42dcd8 sets true;0x42dcf0..f4 calls0x31e6ac(true);0x42dd0c calls0x3424fc",
        "0x42dd90..98 clears local LazyState through helper;0x42ddac..b0 calls0x31e6ac(false)",
        "TaskList metadata fieldrecord0x99d8d34=__hasAppeared",
        "0x395b90 loads ScenePhase type and0x395d14..d34 attaches further lifecycle helper; precise scene semantics remain unresolved"
      ],
      "limits": [
        "VM setter0x31e6ac reads dynamic offsetslot0xb0c8da8. Exact property-name-to-offset binding not closed, so it is not asserted to be _isTaskListVisible solely by inventory.",
        "0x3424fc downstream behavior not fully reconstructed; do not label it restoreScrollPosition.",
        "No explicit haptics discovered in these selected callbacks; this is scoped absence, not global absence."
      ]
    },
    {
      "id": "LISTLIFE-03",
      "classification": "official-artifact-observation",
      "conclusion": "The content parent has stable section/item generic identities and explicit source/search/selection callbacks, but the selected parent tree does not contain ScrollViewReader, scrollPosition or IDView.",
      "source": [
        "CodexTaskListContent descriptor0x9560294 conformance0x7cf6ed8 body0x39f060→0x397608",
        "existing fulltree record0x7cf7528 reused: CodexTaskListContainer + section/item ForEachWithIndex and TaskSection.ID/Item.ID, row wrappers and source controls",
        "0x397df0 refreshable /0x397e38 scrollDisabled /0x397ecc animation(value:) /0x397f48 modifier",
        "selectedThreadID fieldindex29; source callbacks0x396ac0..0x396b08→0x42e0dc/0x42e12c/0x42e130",
        "row action0x39e830..0x39e8d4 dispatches supplied showCodexThread/actionHandler callbacks, not a List selection binding"
      ],
      "limits": [
        "Some tree nominal nodes retain anonymous descriptor addresses; no internals invented.",
        "Generic-tree absence does not prove no viewport adapter exists in an untraced outer owner.",
        "Correspondence between every ForEach concrete item ID and host fixture ID is an independent adapter obligation."
      ]
    },
    {
      "id": "LISTLIFE-04",
      "classification": "official-artifact-observation-metadata-only",
      "conclusion": "The top-level owner has account-scoped settings for collapsed remote sections, grouping, chats-first and project sorting, plus an OrderedDictionary keyed by CodexRemoteHostIdentity for host view models. Host view model separately stores selectedThreadID and task-list data snapshots. Snapshot/cache fields are data inventory, not reading-position evidence.",
      "source": [
        "CodexViewModel descriptor0x955df7c fields0x99d5c20/2c/38/44: AccountScopedSetting wrappers",
        "_codexRemoteViewModelsByHostIdentity field0x99d5c5c typed OrderedDictionary<CodexRemoteHostIdentity,CodexRemoteHostViewModel>",
        "CodexRemoteHostViewModel descriptor0x95a8574 fieldrecords include _selectedThreadID: CodexRemoteThreadRepositoryID, restoredTaskListSnapshot/lastSavedTaskListSnapshot:CodexRemoteTaskListSnapshot",
        "existing frozen inventory swift-types-full.txt: CodexRemoteTaskListSnapshot fields=codexHomePath,usesRecencySort,tasks; TaskListCacheWindow fields=oldestFetchedDate,hasMoreThreads"
      ],
      "limits": [
        "No host selected-thread setter/restore callback closed in this bounded pass.",
        "No snapshot serialization consumer or cross-process policy proved here.",
        "Account-scoped grouping/collapse wrappers do not imply separately persisted filter-specific viewport anchors.",
        "Host class field-kind1 is supported here only as field-record inventory; no unsupported runtime offsets inferred."
      ]
    }
  ],
  "independent_design_recommendations": [
    {
      "decision": "Keep the existing runtime-proven back-to-list position behavior; do not add an alleged official viewport algorithm from unknown evidence.",
      "classification": "independent-host-adapter"
    },
    {
      "decision": "If explicit reading restoration is later needed, make it a separate host adapter with scope(account,home instance,source/filter,grouping,search state) and stable semantic row identity. Save visible row/relative offset before navigation or scope transition; restore only when that scoped row exists, otherwise use an explicit fallback. Selection/navigation and reading anchor are separate state.",
      "classification": "independent-design-suggestion-not-official-recovery"
    },
    {
      "decision": "Keep data-cache recovery, source/group/collapse preferences, current navigation target, ephemeral visibility and viewport reading state separate. Do not interpret restoredTaskListSnapshot as a viewport snapshot.",
      "classification": "independent-design-suggestion-supported-by-type-boundaries"
    }
  ],
  "precise_remaining_boundaries": [
    "0x31e6ac dynamic offsetslot0xb0c8da8 semantic field binding;0x3424fc first-appearance downstream effect.",
    "0x395d14..0x395d34 helper0x7573688 and0x395dcc→0x3dedac scene-phase callback semantics.",
    "CodexRemoteHostViewModel._selectedThreadID read/write navigation consumers and any persisted selected-thread restore.",
    "Unidentified outer viewport owner, if one exists; no source-backed per-filter/per-host anchor map or process-restart scroll policy established.",
    "Root didReturnToTaskList remains optional callback with destinations unresolved after0x5319ac per retained v540 report."
  ],
