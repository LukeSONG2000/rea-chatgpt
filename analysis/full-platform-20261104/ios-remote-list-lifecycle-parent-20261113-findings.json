  "scope": "iOS293 ordinary Remote task list parent, visibility/selection lifecycle, and storage boundary; three bounded candidate groups, static only",
  "artifact": {
    "path": "recovered/ios-1.2026.293/Payload/ChatGPT.app/Frameworks/ChatGPT.framework/ChatGPT",
    "sha256": "12c03ceded0ce669421b6a9a4e4799104a4a82e491a425652df1aa92a116a6c9",
