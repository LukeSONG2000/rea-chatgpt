    {
      "id": "NAV537-05",
      "status": "partial",
      "conclusion": "The destination callback wraps303aec content with navigationBarBackButtonHidden and an additional toolbar. Back-button-hidden is true when the callback local predicate at stack+6c is true, otherwise it tests HomeRoot.dismiss function word +20. The predicate is calculated from hasPresentingTaskList and task identity comparisons. This is an outer destination policy, and its additional toolbar closure42d8c4 must be followed before deciding title alignment.",
      "evidence": [
        "root-navigation-container.asm",
        "root-navigation-container.json",
        "ios-remote-v536-home-navigation-metadata.json"
      ],
      "offsets": [
        "0x30375c..0x303840 local predicate production",
