    {
      "id": "NAV537-03",
      "status": "verified-static-with-branch-limits",
      "conclusion": "In the captured non-alternate branch, 3406b4 mutates the navigation array with a high-bit tagged thread payload, either replacing the last entry or appending one, then calls 3013cc. 3013cc funnels writes to32c63c directly or via closure3e12c4/3ea6fc. 32c63c writes the incoming array at the field offset loaded from b0c8db8 through4668ac. This is actual state mutation, beyond the earlier indirect action hypothesis.",
      "offsets": [
        "0x340824..0x34082c high-bit replace",
        "0x340ccc..0x340ce0 high-bit append",
        "0x340cf0 ->0x3013cc",
        "0x301418 ->0x32c63c",
        "0x301424..0x30142c closure=0x3e12c4",
        "0x3e12c4 ->0x3ea6fc ->supplied0x32c63c",
        "0x32c654..0x32c65c ->0x4668ac",
        "0x4668b0 store x0 at x20+fieldOffset"
      ],
      "evidence": [
