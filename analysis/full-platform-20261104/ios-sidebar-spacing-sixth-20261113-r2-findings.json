  "official_observations": [
    {
      "id": "actual-navigation-cell-carrier",
      "conclusion": "The generic HomeMenuLabelStyle.Style navigation registration directly uses UICollectionViewCell, without the custom HistoryCollectionViewCell or UIKit ListCell.",
      "sources": [
        "metadata helper0x1392888..0x1392898 ->record0x7dae9d0",
        "record relative target resolved by0xfaa78",
        "mangled CellRegistration<So20UICollectionViewCellC,HomeMenuLabelStyle.Style>"
      ],
      "evidence": "registration-type-7dae9d0.json",
      "limit": "Typed generic cell is independently proved. No implication that HistoryItem shares this carrier; record7dae9e0 specifically has custom HistoryCollectionViewCell/HistoryItem."
    },
    {
      "id": "generic-navigation-host-margin",
      "conclusion": "A real generic HistoryNavigationCell configuration factory initializes UIHostingConfiguration<HistoryNavigationCell,EmptyView>, then applies .margins(.all,EdgeInsets(top2,leading10,bottom2,trailing10)), then returns. No fixed48 branch or minSize call appears in this selected whole factory.",
      "sources": [
        "registration closure0x1358840 supplies metadata record0x7daea20 to0x1356fa8",
        "0x7daea20 ->mangled0x8d8df50 UIHostingConfiguration<HistoryNavigationCell,EmptyView>",
        "content configuration builder0x1358834 ->0x12a4cdc",
        "0x12a4d30 helper0x138d4f8 ->0x7c490f0 UIHostingConfiguration.init(content:)",
        "0x12a4d38 ->0x7c49b1c Edge.Set.all",
        "0x12a4d3c ->0x138ba68",
        "0x138ba68..0x138ba74 puts2,10,2,10 in d0..d3",
        "0x138ba84 ->0x7c490d8 UIHostingConfiguration.margins EdgeInsets",
        "0x12a4d40 return value cleanup; no additional modifier"
      ],
      "evidence": [
        "common-navigation-host-init.asm",
        "hosting-margin-helper.asm",
        "navigation-more-config-type-corrected.json",
        "hosting-import-bindings.json"
      ],
      "limit": "Selected generic Navigation factory is positively closed; every individual feature selector/dequeue callback binding is not newly named. Do not confuse source rawItem20 with a proved product feature name."
    },
    {
      "id": "library-host-margin",
      "conclusion": "The FileLibrary-specific configuration independently uses exactly the same .margins(.all,2/10/2/10) helper. This is a real source parent outside the inner Library row.",
      "sources": [
        "registration closure0x1358170 supplies metadata record0x7daeca0 to0x1356fa8",
        "0x7daeca0 ->mangled0x8d8e524 UIHostingConfiguration<HistoryFileLibraryCell,EmptyView>",
        "configuration builder0x1358164 ->0x12a6038",
        "0x12a60b8 ->0x138d4f8 ->UIHostingConfiguration.init(content:)",
        "0x12a60c0 Edge.Set.all",
        "0x12a60c4 ->0x138ba68 exact2/10/2/10",
        "0x12a60c8 cleanup/return"
      ],
      "evidence": [
        "library-host-init.asm",
        "library-register-type.json",
        "hosting-margin-helper.asm"
      ],
      "limit": "Library body provider12a169c is distinct from its actual configuration factory12a6038. Former alone could not establish hosting margins."
    },
    {
      "id": "factory-name-correction",
      "conclusion": "0x12a1330 installs/updates cell configuration lifecycle for a captured item and controller; it is not the constructor whose visible inner fields should be mistaken for final UIHostingConfiguration margins. The handler calls actual typed configuration producer before assigning UIContentConfiguration.",
      "sources": [
        "1356efc..1356f7c ->138ca84->12a1330 captures content/item ownership",
        "1356f8c loads concrete generic config metadata, then1356fa8",
        "1356fa8 resolves UIHostingConfiguration metadata/conformance, invokes captured builder, assigns UIContentConfiguration at1356ff4"
      ],
      "limit": "0x1356f8c specifically resolves PersonalAssistantHistoryNavigationCell; do not call that branch clock/customize/Codex. Used to recover generic pattern, not restored personal content."
    }
  ],
  "minimum_implementation": {
    "feature_carrier": "For current feature section use separately registered plain UICollectionViewCell; retain history swipe-capable ListCell as explicitly independent adapter. Apply source outer hosting margins2/10/2/10 to generic NavigationCell and FileLibrary-shaped feature rows, retain recovered inner row minimum44, padding and scalable typography.",
    "do_not": "Do not fixed-height feature rows48, alter estimated60 to48, or add compositional interGroupSpacing4. Do not apply feature horizontal10 to HistoryItem.",
    "expected_effect_classification": "Static inference to verify with actual host frames: child minimum44 plus hosting top/bottom2 naturally permits48 at ordinary size; no guarantee is made for arbitrary text, font, accessibility or runtime constraints.",
    "runtime_next": "One Chinese/light ordinary-size frame check after integration; compare original and new cell frame/content frame, verify full-row activation, scrolling and sidebar close behavior. Do not broaden to a full theme/language matrix."
  },
