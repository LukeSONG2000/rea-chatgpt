        "0x1a2860c→0x2675ac sets minWidth=nil and idealWidth=nil",
        "0x1a28610 mov x4,#0xc00000000000;0x1a28614 movk x4,#0x4086,lsl48 yields IEEE double0x4086c00000000000=728",
        "0x1a28618→0xbb3784 sets maxWidth optional tagw5=0;minHeight=nil",
