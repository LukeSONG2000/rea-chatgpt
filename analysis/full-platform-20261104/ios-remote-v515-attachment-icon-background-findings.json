  "evidence_type": "official_artifact_observation",
  "findings": [
    {
      "id": "actual-circle-background",
      "status": "verified-static",
      "source": [
        "0x607f8f8..0x607f924",
        "0xa9879c0",
        "0x971f980",
        "0x6ec82cc..0x6ec8304",
        "0x6ec8318",
        "0x6ec8470..0x6ec856c",
        "0x838d118",
        "0x6ec837c"
      ],
      "conclusion": "ActionIconStyle override installs a nonnil AdaptiveTertiaryStyle ShapeStyle existential in iconBackgroundColor. Icon consumer applies iconPadding10, obtains the optional ShapeStyle, type-erases into AnyShapeStyle and builds Optional<_ShapeView<Circle,AnyShapeStyle>>. View.background(_:alignment:) attaches that Circle to the padded glyph. The base icon frame is24, therefore ordinary base-scale circle diameter is44; icon/font metrics can scale. No independent fixed circle radius or material blur is created by this icon-background branch.",
      "reconstructed_order": [
        "SVGOrImagePart with iconSize24/iconFontSize18 regular and iconForegroundStyle",
        "padding(10)",
        "background(Circle filled with AnyShapeStyle(AdaptiveTertiaryStyle), alignment:center)"
      ],
      "limits": [
        "Dynamic type adjusts iconSize/font via existing scaled-metric consumers. Do not force total44 when these metrics scale.",
        "Exact platform runtime blending and appearance remain visually unverified."
      ]
    },
    {
      "id": "adaptive-tertiary-resolver",
      "status": "verified-static",
      "source": [
        "0x8384c20",
        "0x6f44388 ->0x6f44154",
        "0x6f4419c",
        "0x6f441a0..0x6f441cc",
        "0x6f441d4..0x6f44268",
        "0x6f4426c",
        "0x6f4427c..0x6f44370",
        "0x1bdeac",
        "0x74f0420",
        "0x74ecf70"
      ],
      "conclusion": "AdaptiveTertiaryStyle resolves using SwiftUI EnvironmentValues.backgroundMaterial and colorScheme plus iOS26 availability. It returns a color with an explicit blend mode. Material is an environment input, not a blur effect generated for the icon itself.",
      "branches": [
        {
          "condition": "iOS>=26 and backgroundMaterial == nil",
          "color": "OneOff/AppForeground",
          "opacity": 0.02,
          "blendMode": "normal",
          "literals": [
            "0x7d49700",
            "0x45aadc→0xaad5818"
          ]
        },
        {
          "condition": "iOS>=26 and backgroundMaterial != nil and colorScheme == light",
          "color": "OneOff/AppForeground",
          "opacity": 0.04,
          "blendMode": "plusDarker",
          "literals": [
            "0x7d3e0d8",
            "0xaad57f0"
          ]
        },
        {
          "condition": "iOS>=26 and backgroundMaterial != nil and colorScheme == dark",
          "color": "OneOff/AppForeground",
          "opacity": 0.07,
          "blendMode": "plusLighter",
          "literals": [
            "0x7d49650",
            "0xaad5800"
          ]
        },
        {
          "condition": "iOS<26",
          "color": "ChatGPT/bg/tertiary",
          "opacity": 1,
          "blendMode": "normal",
          "source": "0x6f442ec→0x74ecf70;0x6f442fc→0x45aadc"
        }
      ],
      "asset_reuse": [
        "OneOff/AppForeground official catalog light black, dark white already captured v448-assets.json",
        "ChatGPT/bg/tertiary light/dark official catalog already captured v439-presentation-bindings.json"
      ],
      "limits": [
        "The effective SwiftUI backgroundMaterial value inherited by the official attachment hosting subtree has not been closed. UIKit UIGlassEffect presence alone does not establish that SwiftUI EnvironmentValues.backgroundMaterial is nonnil.",
        "Normal enabled background does not depend on Plan selected state, enabled state or isPressed in this resolver.",
        "Future/unknown colorScheme fallback flows through the light opacity default and normal blend; only current light/dark branches are listed for implementation."
      ]
    },
    {
      "id": "pressed-disabled-layers",
      "status": "verified-static-reused",
      "source": [
        "0x607f974..0x607f9c0",
        "0x6ec88a0..0x6ec8964",
        "0x837f680",
        "0x6f48530",
        "0x6f48624..0x6f486ac"
      ],
      "conclusion": "The ordinary row style creates ScaleButtonStyle(scale:1,opacity:0.4,disabledOpacity:0.6,animation:nil). Pressing affects the entire styled label including the new circle. iconBackgroundColor itself is unchanged. The style factory independently multiplies glyph/title foreground by enabled?1:0.6.",
      "formula": "label.scaleEffect(isPressed ? 1 : 1).opacity(isPressed ? 0.4 : 1).opacity(isEnabled ? 1 : 0.6).animation(nil,value:isPressed)",
      "limits": [
        "When both factory enabled=false and SwiftUI environment isEnabled=false apply, glyph/title alpha factors multiply while the background receives the outer disabled modifier only. Preserve actual caller conditions.",
        "This reuses the already closed v514-outside-dismiss-pressed-findings consumer and reads the v513 override. It adds no new universal ButtonStyle rule."
      ]
    },
    {
      "id": "plan-on-off-first-level-row",
      "status": "verified-static",
      "source": [
        "0x1961694..0x19618dc",
        "0x19616e8..0x19616fc",
        "0x1961728→0x74f8474",
        "0x1961730",
        "0x196183c..0x1961848",
        "0x457ac0",
        "0x1d2e324"
      ],
      "conclusion": "This 293 first-level Plan row keeps literal title Plan mode and OpenAI/Symbols/list-circle. Style variant raw0 is always passed via457ac0. Factory enabled is the inverse of isPlanModeActionDisabled. There is no current-plan-state-dependent title/icon/style branch in this row builder. The action captures isPlanModeEnabled and passes its logical inverse to the setter.",
      "limits": [
        "No claim about Plan indicators outside the attachment menu or behavior in the newer user screenshot.",
        "Row presence still depends on supportsPlanMode from v512."
      ]
    }
  ],
  "why_omitted": {
    "classification": "static_inference_from_existing_evidence_gap",
    "conclusion": "v513 explicitly left field16 iconBackgroundColor unresolved. Only glyph/foreground/padding were connected, omitting the independently consumed optional Circle background. The complete style application must retain or explicitly track every consumed field across factory and consumer; image matching alone would not have identified the environment-dependent blend behavior."
  },
