  "development_decisions": [
    "An ordinary CodexPane adapter can faithfully supply nil dismissal and nil transcript-scroll callback while preserving openMenu and didReturnToTaskList. Scope this to the recovered pane branch.",
    "For the mapped standard pane route, retain ordinary new-thread control and inherited native back behavior rather than synthesizing an extra custom dismiss button.",
    "Keep thread title principal on iOS26+ with the source label constraints. Current evidence does not authorize forced leading, toolbarRole(editor), or an arbitrary width spacer.",
    "The host navigationTitle(task.title) differs from the recovered empty title on one root branch, but selected-thread ownership is not yet proved. Do not treat root empty title as a direct thread deletion instruction."
  ],
  "remaining_boundaries": [
    {
      "id": "ordinary-root-switch",
      "last_proven": "ConversationRootViewModel.PaneState.codex type0x8c21d82 equals ConversationRootCodexPane.viewModel type. Pane body53dab8 parameter producer is closed.",
