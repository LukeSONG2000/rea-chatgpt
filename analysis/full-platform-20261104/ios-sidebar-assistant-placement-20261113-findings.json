{
  "schema_version": 1,
  "id": "ios-sidebar-assistant-placement-20261113",
  "status": "partial",
  "target": {
    "platform": "iOS",
    "version": "1.2026.293",
    "sha256": "12c03ceded0ce669421b6a9a4e4799104a4a82e491a425652df1aa92a116a6c9"
  },
  "scope": "Two bounded groups: catalog availability/leading projection; actual Item.orbit selection gate and destination enum. Static only. No assistant page expansion, backend, product/build/device changes.",
  "official_artifact_observations": [
    {
      "id": "catalog-orbit-identity",
      "sources": [
        "0x1275624..0x127563c",
        "0x129e298..0x129e2c0",
        "0x7db6428",
        "Item descriptor0x95927d0"
      ],
      "conclusion": "Catalog byte14 maps through the original converter to Item emptyOrdinal14 with outer enum byte8: Item.orbit. The catalog byte and Item emptyOrdinal happen to match here; the mapping table must still be used, not generalized."
    },
    {
      "id": "visibility",
      "sources": [
        "0x12983d8..0x12983ec table0x12995d0",
        "0x1298464..0x1298470",
        "0x138f944",
        "0x129f02c..0x129f05c"
      ],
      "conclusion": "Catalog candidate14 dispatches to 0x1298464, reads current HistoryViewModel via 0x138f944, and calls 0x129f02c. Only true admits orbit into availableSet. The getter returns the Bool at VM+0x924 after its original observation access helpers.",
      "limits": "Upstream server/account/experiment assignment is not recovered. Field inventory includes _orbitAvailable; its offset-vector-to-0x924 identity is not separately proven here. The exact functional admission consumer is proven, so do not replace it with unconditional availability."
    },
    {
      "id": "leading-position",
      "sources": [
        "0x1275624..0x127563c constructs single-element [14] at stack+0x70",
        "0x12759b0..0x12759b4 stores that array first in the array-of-groups",
        "0x1275a70..0x1275b64 filters flattened candidates by membership while preserving iteration",
        "0x1275ba8..0x1275c30 maps admitted bytes through captured0x129e298",
        "0x1275c90 stores mapped leading group atstack+0x48",
        "0x1276570..0x1276588 supplies that group as x0 to final projector0x12753c4"
      ],
      "conclusion": "The source constructs orbit as the first catalog group before the ordinary feature groups; unavailable candidates are filtered out. The leading mapped group is retained as the first input to final expanded/collapsed projection. Orbit is not an extra item appended at the end of More.",
      "limits": "This observation answers orbit placement only. It does not establish every other feature order, live catalog assignment, or a universal total visible row count."
    },
    {
      "id": "selection-route",
      "sources": [
        "0x12a9ad0..0x12a9af8 validates empty Item ordinal14 and supplies availability getter129f02c plus tag28",
        "0x12a95e8 calls12acacc",
        "0x12acacc..0x12acb24 invokes getter again and proceeds only iftrue",
        "0x12acb10 _swift_storeEnumTagMultiPayload",
        "HistorySelection descriptor0x9592308 fieldordinal28 orbit",
        "0x1391090 dynamic callback field b17d3b8",
        "0x1397c20 loads closure function/context",
        "0x138e2bc calls closure with selection and zero auxiliary args"
      ],
      "conclusion": "Tap emits HistorySelection.orbit only after rechecking the same actual availability supplier. This is the assistant root selection route, not Settings Personalization or Customize.",
      "limits": "The injected callback implementation and concrete OrbitConversationScreenTemplate-to-page DI closure are dynamic; earlier root/template proof remains partial. No backend functionality is inferred."
    }
  ],
  "host_integration_proposal": {
    "source_backed": [
      "Move the assistant registry identity orbit from additionalFeatureCatalog tail into the first visible catalog position when its provider reports it available.",
      "Ensure it is absent from the More registry after moving, avoiding duplicates.",
      "Tap uses the existing orbit selection route and current availability admission; retain shell return/openSidebar ownership.",
      "Name, portrait/icon and unread indication come from assistant/profile state. Preserve absent/unknown defaults rather than copying personal R2-D2 screenshot content."
    ],
    "independent_adapter": [
      "The frontend fixture can explicitly provide availability=true with synthetic identity; this is fixture data, not proof of official account eligibility.",
      "Existing independent Orbit page may be the destination preview; source-equivalent concrete DI registration and service behavior remain unclosed."
    ],
    "not_proposed": [
      "No assistant backend or new assistant subpages.",
      "No change to other feature order, catalog threshold or feature expansion policy.",
      "No fallback personal screenshot identity."
    ]
  },
  "unknowns": [
    {
      "boundary": "VM+0x924 upstream assignment and field-offset identity",
      "next_minimum_action": "Only if account eligibility needs reproduction, bind descriptor _orbitAvailable offset vector and actual assignment; not needed for explicit fixture availability."
    },
    {
      "boundary": "HistorySelection.orbit callback injection -> concrete Orbit pane DI registration",
      "next_minimum_action": "Reuse previously documented root optional OrbitConversationScreenTemplate boundary; do not claim full original service route."
    },
    {
      "boundary": "Default assistant name/icon resource fallback",
      "next_minimum_action": "Separate independent worker covers provider/title/icon. This placement pass does not infer a universal product identity."
    }
  ],
  "validation": {
    "candidate_groups": 2,
    "static_only": true,
    "product_modified": false,
    "tests_builds_device": false,
    "target_or_service_execution": false,
    "stopping_reason": "Actual availability consumer, leading source position and selection enum consumer are closed. Remaining dynamic assignment/name/page DI are precise independent boundaries."
  },
