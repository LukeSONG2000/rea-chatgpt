  "official_artifact_observations": [
    {
      "id": "FOOTSIB-01",
      "conclusion": "The actual footer sibling order is optional CopyButton, positive-feedback AsyncButton, negative-feedback Button, fork-thread AsyncButton, HookStatsButton, ResponseTimestamp. This comes from the native HistoryFragment tail, not desktop or reference screenshots.",
      "source": [
        "existing fully decoded native tail record0x7e11da8",
        "HistoryFragment descriptor0x95acb58; fieldrecords0x9a37818 positiveFeedback,0x9a37824 negativeFeedback,0x9a37830 forkThread; metadata offsets0x9c/0xa0/0xa4",
        "0x1a342e4..0x1a344a8 positive callback optional gate",
        "0x1a34594..0x1a34628 negative callback optional gate",
        "0x1a34634..0x1a34790 fork callback optional gate"
      ],
      "limits": [
        "Each action requires its own supplied callback. A completed turn does not prove these optional capabilities are present.",
        "Positive/fork async dispatch, pending/error/result navigation are not fully closed here. No service feedback/fork behavior claimed."
      ]
    },
    {
      "id": "FOOTSIB-02",
      "conclusion": "The completed-turn outer admission is turnState rawtag2. showsFooterActions gates interactive actions and hook stats; timestamp is independently admitted by responseCompletedAt being present after those action branches merge.",
      "source": [
        "0x1a341e8..0x1a341fc turnState raw2 check; nonmatching returns",
        "0x1a3420c..0x1a34224 showsFooterActions read",
        "false path0x1a342bc→0x1a344a8→0x1a344b8→0x1a344bc→0x1a34790",
        "0x1a3479c cbz showsFooterActions→0x1a347f4 skips HookStats",
        "0x1a34804 reads metadata+0xf4 responseCompletedAt;0x1a34818 Optional tag check;0x1a3482c copies date into optional Timestamp",
        "metadata record0x9a37920 responseCompletedAt(index57),0x9a3792c hookStats(index58)"
      ],
      "limits": [
        "ABI raw2 is not a wire status name or serialized service ordinal.",
        "responseCompletedAt must be supplied by the completion owner; creating Date() during View.body would invent completion time.",
        "No requirement that responseCopyText exist for timestamp; no requirement showsFooterActions=true."
      ]
    },
    {
      "id": "FOOTSIB-03",
      "conclusion": "The footer HStack uses vertical center alignment and explicit spacing12. Its outer wrapper is leading aligned; full outer padding amount remains unresolved.",
      "source": [
        "actual layout closure0x1a34aa0",
        "0x1a34ae4 SwiftUI.VerticalAlignment.center",
        "0x1a34ae8 mov doublebits0x4028000000000000=12.0",
        "0x1a34aec→0x4ddac8 stores alignment/spacing and zero optional discriminator",
        "0x1a34b20 SwiftUI.Alignment.leading; native tail tree contains HStack<SubviewsCollection> + PaddingLayout + FlexFrameLayout"
      ],
      "limits": [
        "No arbitrary gap or fixed overall footer height added.",
        "The padding edge getter/argument registers pass shared helpers; exact edge amount not claimed from adjacent constants."
      ]
    },
    {
      "id": "FOOTSIB-04",
      "conclusion": "The original timestamp uses an every-minute TimelineView with stable completedAt, and a separate text view taking completedAt, now, calendar, locale and timeZone.",
      "source": [
        "CodexRemoteResponseTimestamp descriptor0x95adc60 conformance0x7e1a628 body0x1a08dd0→0x1a08b44",
        "0x1a08b84 EveryMinuteTimelineSchedule metadata /0x1a08be8 init /0x1a08ce4 TimelineView.init",
        "Timeline contentclosure0x1ced918→0x1a832fc generic view construction",
        "actual CodexRemoteResponseTimestampText descriptor0x95afbcc conformance0x7e21a48 body0x1a09498→0x1a08dd4",
        "text fields completedAt/now/_calendar/_locale/_timeZone"
      ],
      "limits": [
        "0x1a832fc is a generic construction helper; it must not be mislabeled as the TimestampText body.",
        "Timeline wall clock refresh does not replace or mutate the completion event timestamp."
      ]
    },
    {
      "id": "FOOTSIB-05",
      "conclusion": "Timestamp text uses the original caption semantic font and ChatGPT/text/secondary. It carries a more complete localized accessibility label.",
      "source": [
        "0x1a0932c→0x74e27b8→0x74e27a4→0x74e27e8;importslot0xaad3900=SwiftUI.Font.TextStyle.caption",
        "0x1a09358→0x74ee310→literal0x8a51bc0 ChatGPT/text/secondary",
        "0x1a09118 day(defaultDigits),0x1a09150 month(wide),0x1a09184 year(defaultDigits),0x1a091b8/1c8 hour(defaultDigits,amPM.abbreviated),0x1a0920c minute(defaultDigits),0x1a09260 Date.formatted for full accessibility date",
        "0x1a0938c literal0x88bdd90 codex_remote_response_completed_at;0x88bddc0 default Response completed at ;0x1a09464 accessibilityLabel"
      ],
      "limits": [
        "Shared semantic font resolver is used; no fixed pixel size or forced font weight inferred.",
        "Locale controls output order, digits and AM/PM; do not hard-code HH:mm or an English date string."
      ]
    },
    {
      "id": "FOOTSIB-06",
      "conclusion": "Visible timestamp formatting is a dedicated CodexRemoteMessageTimestampFormatStyle with calendar-relative branches, rather than a constant time format.",
      "source": [
        "formatstyle descriptor0x95b13ac conformance0x7e24ee4",
        "format witness0x1a0a470→0x1a0949c",
        "0x1a09858..0x1a098b4 builds hour(defaultDigits,amPM.abbreviated)+minute(defaultDigits)",
        "0x1a098d0 importslot0xaac95e0=Calendar.Component.day;0x1a09914 isDate(equalTo:toGranularity:)",
        "same-day true branch0x1a0992c..0x1a09944 uses current base time format",
        "otherwise0x1a09950 abbreviatedMonth/0x1a0997c defaultDigitsDay added",
        "0x1a099ac importslot0xaac95f8=Calendar.Component.year;0x1a099d8 compares year",
        "different-year0x1a09ae4..0x1a09afc adds year(defaultDigits)",
        "same-year0x1a09a3c/4c startOfDay,0x1a09a5c dateComponents,0x1a09a84 day;0x1a09aa0..aac checks nonnil day distance1..6; weekday branch0x1a09b48..0x1a09b60"
      ],
      "limits": [
        "Exact weekday symbol chosen by helper0x11a7620 and final replacement/reset of date components has not been fully proven. Preserve this exact breakpoint; do not present a partial formatter as fully equivalent.",
        "No new branch was inferred from user screenshots."
      ]
    },
    {
      "id": "FOOTSIB-07",
      "conclusion": "Positive/negative feedback and fork original glyph/label consumers are present, with selected-positive glyph switching.",
      "source": [
        "positive label0x1c209f0→0x75d7bb8: Good response",
        "0x1c20a10 reads metadata+0xa8=isPositiveFeedbackSelected; helper0x2c60c0 compares bool1; true→0x74fbff8→literal0x8a57610 OpenAI/Symbols/thumb-up-fill;false→0x74fc094→0x8a57660 OpenAI/Symbols/thumb-up",
        "negative0x1a345b0→0x75d7bd8: Bad response;0x1a345b8→0x74fbf58→0x8a575c0 OpenAI/Symbols/thumb-down",
        "fork label0x1a34a68→0x74f3ef4→0x8a539b0 OpenAI/Symbols/arrow-branch",
        "positive async identityprefix0x88b3140 positive-feedback- plus supplied identifier;fork async identity inline fork-thread- plus supplied identifier",
        "positive submitting binding metadata+0xac at0x1a34360..70;fork binding metadata+0xb0 at0x1a34684..94"
      ],
      "limits": [
        "Fork title helper0x2417fec needs its own enum representation proven; do not infer title from neighboring speed strings in helper.",
        "Good response/Bad response are source-owned localizable default strings; full localized resource-key lookup not closed here.",
        "No callback identity/payload service schema reconstructed; callbacks remain optional front-end contracts."
      ]
    }
