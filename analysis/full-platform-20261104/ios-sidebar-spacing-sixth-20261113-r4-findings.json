    "sha256": "12c03ceded0ce669421b6a9a4e4799104a4a82e491a425652df1aa92a116a6c9"
  },
  "status": "partial",
  "scope": "One bounded feature-catalog to pinned-header spacing producer group; static only; no product/build/device operations.",
  "observations": [
    {
      "type": "official_artifact_observation",
      "locations": [
        "0x95927d0 Item field descriptor",
        "0x8d8b3aa Section?",
        "0xa4c4a18",
        "0xa4c4e50"
      ],
      "conclusion": "Item.spacing payload is optional Section, not a numeric spacing value. Pinned static prefix is spacing(.pinned) followed by a separate sectionHeader(.pinned).",
      "limits": "Raw payload 1 is the pinned section identity, not a point size."
    },
    {
      "type": "official_artifact_observation",
      "locations": [
        "0x1298ab4..0x1298b0c",
        "0x138fdc8",
        "0x1393dc4"
      ],
      "conclusion": "When pinned projected items are nonempty, append pinned section. If snapshot.numberOfItems is already nonzero, append spacing(.pinned); then append pinned header only if title producer 0x129f2b8 supplies a title. Continue with pinned items.",
      "limits": "numberOfItems is the whole snapshot count, not a per-section count. Source establishes semantic ordering and visibility, not actual height."
    }
  ],
  "integration": {
    "implemented_by_worker": false,
    "proposal": "Preserve a semantic spacing row in future projection only after binding its actual view/height consumer. Do not introduce a guessed numeric gap or infer height from the Section payload. Existing host omission is documented; this pass supplies no scalar fix.",
    "known_order": [
      "feature catalog",
      "conditional spacing(.pinned)",
      "conditional pinned section header",
      "pinned items"
    ]
  },
  "unknowns": [
    {
      "boundary": "0x12a0c64 -> 0x12a0d70 registration capture -> actual spacing view and sizing policy",
      "reason": "Raw payload-tag 7 dispatch reaches 0x12a0c64. Actual captured registration identity and final view height producer are not closed. Equal stack offsets in separate functions do not establish capture identity.",
      "next_minimum_action": "Bind provider outer capture layout to the registration loaded at 0x12a0d70 before reading a specific view sizing producer; not undertaken because bounded pass is finished."
    }
  ],
  "rejected_candidates": [
    {
      "file": "spacing-config-consumer.asm",
      "candidate": "0x12a5a88",
      "reason": "Preserved exploration only. It is not proven to be the spacing registration; frame-offset matching across separate functions is insufficient. Its margins must not be adopted for spacing."
    }
  ],
