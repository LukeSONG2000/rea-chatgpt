    {
      "id": "TITLE538-03",
      "status": "verified-static-with-producer-limit",
      "conclusion": "CodexScreen forwards the caller dismiss into CodexNavigationView. CodexScreenContainer forwards ViewParams.dismiss into CodexScreen on its non-taskList branch. These owners preserve the supplied value.",
