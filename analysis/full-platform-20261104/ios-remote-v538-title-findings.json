        "0x40b67c..0x40b684 metadata+0x1c parent dismiss",
        "0x40b688..0x40b690 layout2 and conditional compare",
        "0x40b694 ->0x460dd0 zeros x26/x27 openMenu",
        "0x40b69c..0x40b6ac loads parent openMenu from metadata+0x14 then clears dismiss function",
        "0x40b6b4..0x40b6c8 onTranscript and didReturnToTaskList presence",
        "0x40b6cc..0x40b6e0 concrete HomeNavigationRoot prefix field stores"
      ],
      "branch_truth_table": [
