  "minimal_classifier": {
    "language": "Swift",
    "code": "func suppressPluginEntry(prompt: String, commandsContainGoal: Bool) -> Bool {\n    guard commandsContainGoal else { return false }\n    let trimmed = prompt.trimmingCharacters(in: .whitespacesAndNewlines)\n    guard trimmed.hasPrefix(\"/goal\") else { return false }\n    let remainder = trimmed.dropFirst(5)\n    return remainder.first.map { $0.isWhitespace } ?? true\n}",
    "scope": "Goal suppression only; commandsContainGoal must derive from actual supplied enum candidates, not a provider connectivity flag. This is independent source-derived pseudocode, not recovered Swift source."
  },
