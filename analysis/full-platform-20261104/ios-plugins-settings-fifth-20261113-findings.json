  "findings": [
    {
      "id": "actual-root-navigation-consumer",
      "status": "verified",
      "evidence_kind": "official_artifact_observation",
      "conclusion": "Settings Apps/Plugins connectors(.root) does construct the native ConnectorsView, independently from the Plugins directory root. This is now actual branch/caller evidence, not same-name inference.",
      "source": [
        "10d7fe4 imported View.navigationDestination(for:destination:), closure114e108",
        "114e108 supplies descriptor accessor1052200 and body10d873c through42d2f8",
        "10d8be8 enum switch; table7d86606 outertag3 target10d9358",
        "10d9360 nestedtag at+0x10;table7d8665c innertag4 target10da2c0",
        "10da2c8 ->10dbca4 constructs view object",
        "10dbe48..10dbe80 fills ConnectorsView89bytes with viewModel +0, showConnector +8/+0x10, showApp +0x18/+0x20, dismissRootSheet +0x28/+0x30, showPluginSettings +0x38/+0x40, optional showPluginsDirectory +0x48/+0x50, refreshableAndInteractiveDismissDisabled +0x58=true"
      ],
      "limit": "The underlying connection/service data and lifecycle are not recovered by navigation construction. Constructor alone does not establish a ready-to-port screen."
    },
    {
      "id": "directory-entry-conditional-owner",
      "status": "partial",
      "evidence_kind": "official_artifact_observation",
      "conclusion": "Root constructor supplies the optional showPluginsDirectory callback only when the same raw presentation gate108ba40 is true. Otherwise the callback pair is nil. When present it uses114e688.",
      "source": [
        "10dbdf8 ->108ba40;10dbe08 testsw24;false branch retains x8/x20 zero",
        "10dbe38..3c callback114e688",
        "10dbe74..78 writes optionalcallback+0x48/+0x50",
        "114e688 zero-initializes payload and stores rawtag5 at+0x38;114e6c0 ->10e625c",
        "10e625c creates captured async/presentation work, continuation114e820 not followed in this boundedpass"
      ],
      "limit": "Rawtag5 has not been independently rebound to named Presentation.pluginsDirectory in this pass, nor the async presentation consumer closed. Do not claim concrete sheet/full-screen style or directly launch NativePluginsPage."
    },
    {
      "id": "native-connectors-body",
      "status": "verified",
      "evidence_kind": "official_artifact_observation",
      "conclusion": "ConnectorsView body514202c ->51405b0 builds ConnectorsViewContent, adds navigationDestination/headerProminence and applies refreshableAndInteractiveDismissDisabled via actual interactiveDismissDisabled modifier. Root Settings supplies thatflag=true.",
      "source": [
        "ConnectorsView descriptor9683f58/View witness814c7d4 ->514202c",
        "514202c copies89byte view value and calls51405b0",
        "5140c9c imported navigationDestination",
        "5140eac imported headerProminence",
        "5140ec8 readsown+0x58;5140f04 imported interactiveDismissDisabled"
      ],
      "limit": "Exact refresh action/body ownership and headerProminence case remain unknown. Do not interpret flag as a proved absence of all refresh UI."
    },
    {
      "id": "content-root-and-state-inputs",
      "status": "partial",
      "evidence_kind": "official_artifact_observation",
      "conclusion": "ConnectorsViewContent has a native grouped Form success-content branch plus request-state-conditioned alternatives. It is a settings management list, not the directory marketplace. The proved Form type includes SettingsSection, AppsPrivacyControlPickerRow, ConnectorApp/ConnectorPlugin collections, ConnectorLogoView/SettingsLabelStyle rows, NavigationLinkStyledDisclosureRow and OAIProgressView.",
      "source": [
        "descriptor9685f5c/View body514544c ->514206c",
        "metadataa7bacf8 fieldoffsetvectorbase16 mapped incontent-field-offsets.json",
        "5142088 reads nativePluginSettingsEnabled+0x7d then installedPluginsRequestState+0x28;alternate51420d4 uses usesInstalledApps+0x7a and installedAppsRequestState+0x18;else refreshState+0",
        "content path5142174 ->5142448;5142630 constructsForm;5142654 GroupedFormStyle metadata;51427d4 imported formStyle",
        "Form closure521878c ->5142860",
        "type records8153548/8153550/8153568/8153570 identify nativeForm and contained carriers"
      ],
      "limit": "Symbolic reference inventory is not a reconstructed generic tree or section order. Request-state raw tags, exact visible section labels/order, row visibility, empty/error/retry labels and directory button label/action consumer are not closed. Do not map every inventory type to an always-visible row."
    }
  ],
